{
  "version": 1,
  "marketplace": {
    "name": "crypto-gameplan",
    "repo": "crypto-gameplan/cgp-marketplace"
  },
  "providers": [
    {
      "id": "claude",
      "name": "Claude (Anthropic)"
    },
    {
      "id": "openai",
      "name": "ChatGPT and Codex (OpenAI)"
    }
  ],
  "tools": [
    {
      "id": "git",
      "name": "Git",
      "description": "Version control; Claude Code and Codex need it",
      "kind": "cli",
      "self_updates": false,
      "mac": {
        "method": "brew",
        "package": "git",
        "check": "xcode-select -p >/dev/null 2>&1 && git --version"
      }
    },
    {
      "id": "claude-desktop",
      "name": "Claude Desktop",
      "description": "Claude as a desktop app, with chat, Cowork and Code",
      "kind": "app",
      "self_updates": true,
      "mac": {
        "method": "brew-cask",
        "package": "claude",
        "app": "Claude.app"
      },
      "provider": "claude",
      "finish": {
        "label": "Sign in to Claude Desktop",
        "open": "Claude",
        "how": "Open Claude Desktop and sign in with your Claude account."
      }
    },
    {
      "id": "chatgpt-desktop",
      "name": "ChatGPT Desktop",
      "description": "ChatGPT and Codex in one desktop app",
      "kind": "app",
      "self_updates": true,
      "mac": {
        "method": "brew-cask",
        "package": "chatgpt",
        "app": "ChatGPT.app"
      },
      "provider": "openai",
      "finish": {
        "label": "Sign in to ChatGPT Desktop",
        "open": "ChatGPT",
        "how": "Open ChatGPT Desktop and sign in with your ChatGPT account. Codex is inside the same app."
      }
    },
    {
      "id": "claude-code",
      "name": "Claude Code CLI",
      "description": "Claude in the terminal, for projects and agents",
      "kind": "cli",
      "self_updates": true,
      "requires": [
        "git"
      ],
      "mac": {
        "method": "vendor",
        "install": "curl -fsSL https://claude.ai/install.sh | bash",
        "check": "claude --version",
        "conflicts_cask": "claude-code"
      },
      "provider": "claude",
      "finish": {
        "label": "Sign in to Claude Code CLI",
        "check": "claude auth status 2>/dev/null | grep -q '\"loggedIn\": true'",
        "command": "claude auth login",
        "how": "Sign in with your Claude account; a browser window opens."
      }
    },
    {
      "id": "codex-cli",
      "name": "Codex CLI",
      "description": "OpenAI Codex in the terminal",
      "kind": "cli",
      "self_updates": false,
      "requires": [
        "git"
      ],
      "mac": {
        "method": "brew-cask",
        "package": "codex",
        "check": "codex --version"
      },
      "provider": "openai",
      "finish": {
        "label": "Sign in to Codex CLI",
        "check": "codex login status >/dev/null 2>&1",
        "command": "codex login",
        "how": "Sign in with your ChatGPT account; a browser window opens."
      }
    },
    {
      "id": "node",
      "name": "Node.js",
      "description": "JavaScript runtime for scripts, MCP servers and many AI tools",
      "kind": "runtime",
      "self_updates": false,
      "mac": {
        "method": "brew",
        "package": "node",
        "check": "node --version"
      }
    },
    {
      "id": "uv",
      "name": "uv",
      "description": "Manages Python versions and packages",
      "kind": "runtime",
      "self_updates": false,
      "mac": {
        "method": "brew",
        "package": "uv",
        "check": "uv --version"
      }
    },
    {
      "id": "python",
      "name": "Python",
      "description": "Python, installed and kept separate from the system Python by uv",
      "kind": "runtime",
      "self_updates": false,
      "requires": [
        "uv"
      ],
      "mac": {
        "method": "vendor",
        "install": "uv python install",
        "upgrade": "uv python upgrade",
        "check": "\"$(uv python find)\" --version"
      }
    },
    {
      "id": "docker-desktop",
      "name": "Docker Desktop",
      "description": "Runs containers; free for personal use and small businesses",
      "kind": "app",
      "self_updates": true,
      "mac": {
        "method": "brew-cask",
        "package": "docker-desktop",
        "app": "Docker.app"
      },
      "finish": {
        "label": "Start Docker Desktop once",
        "check": "docker info >/dev/null 2>&1",
        "open": "Docker",
        "how": "Open Docker Desktop, accept its terms and wait until it says it is running."
      }
    }
  ],
  "plugins": [
    {
      "id": "cgp-essentials",
      "name": "CGP Essentials",
      "description": "The skills Crypto Gameplan uses every day",
      "provider": "claude"
    },
    {
      "id": "cgp-effort",
      "name": "CGP Effort",
      "description": "Picks the reasoning effort for every prompt",
      "provider": "claude"
    }
  ],
  "plugin_requires": [
    "claude-code"
  ],
  "profiles": [
    {
      "id": "starter",
      "name": "Starter",
      "description": "Desktop apps plus both AI command line tools, no setup knowledge needed",
      "tools": [
        "git",
        "claude-desktop",
        "chatgpt-desktop",
        "claude-code",
        "codex-cli"
      ],
      "plugins": [
        "cgp-essentials"
      ]
    },
    {
      "id": "builder",
      "name": "Builder",
      "description": "Build agents, scripts and your own projects",
      "tools": [
        "git",
        "claude-desktop",
        "chatgpt-desktop",
        "claude-code",
        "codex-cli",
        "node",
        "uv",
        "python",
        "docker-desktop"
      ],
      "plugins": [
        "cgp-essentials",
        "cgp-effort"
      ]
    }
  ]
}
